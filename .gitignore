# ──────────────────────────────────────────────────────────────
# .gitignore — Files and folders that Git should never track
# ──────────────────────────────────────────────────────────────

# ── Secrets ──────────────────────────────────────────────────
# .env holds API keys and other secrets.  NEVER commit this.
.env

# ── Python bytecode cache ────────────────────────────────────
# Python compiles .py → .pyc into __pycache__/ for speed.
# These are machine-specific and must not be committed.
__pycache__/
*.py[cod]
*$py.class

# ── Generated / user data ───────────────────────────────────
# storage/ will hold generated resumes (PDFs, TeX files).
# This is output data, not source code, so we exclude it.
storage/

# ── Virtual environments ─────────────────────────────────────
# If you create a venv inside the repo, ignore it.
venv/
.venv/
env/

# ── Bundled toolchains ──────────────────────────────────────
# .tectonic/ holds the LaTeX compiler binary downloaded by
# render-build.sh. It is platform-specific (x86_64 Linux) and
# can be 50+ MB, so it stays out of the repo.
.tectonic/

# ── IDE / editor files ──────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── OS junk ──────────────────────────────────────────────────
.DS_Store
Thumbs.db


