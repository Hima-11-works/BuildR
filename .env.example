# ──────────────────────────────────────────────────────────────
# .env.example — copy this file to .env and fill in your values.
#   Windows (PowerShell): Copy-Item .env.example .env
#   macOS / Linux:        cp .env.example .env
# ──────────────────────────────────────────────────────────────

# MiniMax API key (required).
# Get one at https://platform.minimax.io → API Keys.
MINIMAX_API_KEY=your_minimax_api_key_here

# Google OAuth 2.0 Client ID (required for production sign-in).
#
# Identity in BuildR comes from Google's verified `sub` claim, NOT
# from any user-supplied email. To configure Google sign-in:
#
#   1. Open https://console.cloud.google.com/  (create a project if needed)
#   2. APIs & Services → Credentials → Create Credentials → OAuth client ID
#   3. Application type: Web application
#   4. Authorized JavaScript origins:
#        http://localhost:5000      (local dev)
#        https://your-app.onrender.com   (production)
#   5. Copy the Client ID and paste it below.
#
# Without GOOGLE_CLIENT_ID, the /api/auth/google endpoint returns 500
# and no one can sign in.
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here

# MiniMax API base URL (optional, default shown).
# Override only if you are proxying MiniMax through your own gateway.
# MINIMAX_BASE_URL=https://api.minimax.io/v1

# MiniMax model ID (optional, default: minimax-m3).
# Pin a specific model version, or override per deployment.
# MINIMAX_MODEL=minimax-m3

# Enable Flask's auto-reload + interactive debugger (optional, default: off).
# Handy during local development, but the debugger lets anyone who can reach
# the port execute arbitrary Python — never enable this if the server is
# reachable from outside your own machine.
FLASK_DEBUG=1

# Port the dev server listens on (optional, default: 5000).
PORT=5000

# Timeout, in milliseconds, for MiniMax API calls (optional, default: 90000).
MINIMAX_TIMEOUT_MS=90000

# Flask session signing key (required in production).
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
# If not set, a random key is generated at startup (sessions won't survive
# restarts, but fine for local development).
# SECRET_KEY=your_secret_key_here
