# ──────────────────────────────────────────────────────────────
# .env.example — copy this file to .env and fill in your values.
#   Windows (PowerShell): Copy-Item .env.example .env
#   macOS / Linux:        cp .env.example .env
# ──────────────────────────────────────────────────────────────

# Google Gemini API key (required).
# Get one at https://aistudio.google.com → Get API key.
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini API base URL (optional, default shown).
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Gemini model ID (optional, default: gemini-3.8-flash).
# Pin a specific model version, or override per deployment.
# GEMINI_MODEL=gemini-3.8-flash

# Enable Flask's auto-reload + interactive debugger (optional, default: off).
# Handy during local development, but the debugger lets anyone who can reach
# the port execute arbitrary Python — never enable this if the server is
# reachable from outside your own machine.
FLASK_DEBUG=1

# Port the dev server listens on (optional, default: 5000).
PORT=5000

# Timeout, in milliseconds, for Gemini API calls (optional, default: 90000).
GEMINI_TIMEOUT_MS=90000

# Flask session signing key (required in production).
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
# If not set, a random key is generated at startup (sessions won't survive
# restarts, but fine for local development).
# SECRET_KEY=your_secret_key_here

# ── Firebase (client + Admin SDK) ────────────────────────────
# Find these values in the Firebase console → Project settings → Your apps.
# The client-side values (API key, appId, etc.) are safe to commit — they
# are public identifiers. Security is enforced by Firebase Security Rules.
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
FIREBASE_APP_ID=your_firebase_app_id
FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Optional: path to a Firebase service-account key JSON file.
# Required for Admin SDK features (Firestore server-side reads/writes,
# custom token minting, FCM) in local development.
# Download from: Firebase console → Project settings → Service accounts.
# GOOGLE_APPLICATION_CREDENTIALS=path/to/serviceAccountKey.json
